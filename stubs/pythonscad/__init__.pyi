"""Minimal type stubs for the parts of the ``pythonscad`` module that plotter_cad uses."""

from collections.abc import Sequence
from typing import Any, Self

class Solid:
    """A PythonSCAD 2D or 3D object."""

    size: list[float]
    position: list[float]

    def translate(self, v: Sequence[float]) -> Self: ...
    def rotate(self, v: Sequence[float]) -> Self: ...
    def mirror(self, v: Sequence[float]) -> Self: ...
    def scale(self, v: Sequence[float] | float) -> Self: ...
    def offset(self, *args: Any, **kwargs: Any) -> Self: ...
    def color(self, *args: Any, **kwargs: Any) -> Self: ...
    def with_name(self, name: str) -> Self: ...
    def resolve(self) -> Self: ...
    def exists(self) -> bool: ...
    def __add__(self, other: Solid | Sequence[Solid]) -> Self: ...
    def __sub__(self, other: Solid | Sequence[Solid]) -> Self: ...
    def __or__(self, other: Solid | Sequence[Solid]) -> Self: ...
    def __and__(self, other: Solid | Sequence[Solid]) -> Self: ...

def cube(*args: Any, **kwargs: Any) -> Solid: ...
def cylinder(*args: Any, **kwargs: Any) -> Solid: ...
def sphere(*args: Any, **kwargs: Any) -> Solid: ...
def circle(*args: Any, **kwargs: Any) -> Solid: ...
def square(*args: Any, **kwargs: Any) -> Solid: ...
def polygon(*args: Any, **kwargs: Any) -> Solid: ...
def linear_extrude(*args: Any, **kwargs: Any) -> Solid: ...
def hull(*args: Any, **kwargs: Any) -> Solid: ...
def union(*args: Any, **kwargs: Any) -> Solid: ...
def translate(*args: Any, **kwargs: Any) -> Solid: ...
def mirror(*args: Any, **kwargs: Any) -> Solid: ...
def multmatrix(*args: Any, **kwargs: Any) -> Solid: ...
